# Maintainer: Eugene Orefkov
# Prebuilt by the app's GitHub Actions release workflow and uploaded to the
# matching GitHub release as affection-vpn-<pkgver>-linux-x64.tar.gz. The
# bundle is the standard `flutter build linux --release` output
# (binary + data/ + lib/) with the pinned Xray-core runtime and its
# geoip.dat/geosite.dat databases included, installed under /opt/affection-vpn.
#
# The Xray core is bundled, so no separate core install is needed. The
# optional geo packages below only replace the bundled databases with fresher
# ones from the official `extra` repo (the app prefers /usr/share/v2ray when
# present).

pkgname=affection-vpn
pkgver=1.1.15
pkgrel=1
pkgdesc="Native Linux Xray (VLESS) VPN client with subscription support"
arch=('x86_64')
url="https://github.com/EugeneOrefkov/affectionvpn_app"
license=('custom')
depends=(
  'gtk3'
  'libayatana-appindicator'
)
optdepends=(
  'v2ray-geoip: fresher geoip database from the system repos'
  'v2ray-domain-list-community: fresher geosite database from the system repos'
)
source=(
  "affection-vpn-$pkgver-linux-x64.tar.gz::https://github.com/EugeneOrefkov/affectionvpn_app/releases/download/v$pkgver/affection-vpn-$pkgver-linux-x64.tar.gz"
  'affection-vpn.desktop'
  'affection-vpn.png'
)
sha256sums=(
  '1438afbdbdace35d3e94166be3b2ee930dec2624f325d5464bab5f2035e2e292'
  'c609907a827a371fafc466beed43fb412b57d5eac0232fdbe72e306e15d08f46'
  '3c34e1f298d0c9ea3455d46db6b7759c8211a49e9ec6e44b635fc5c87dfb4180'
)

package() {
  install -d "$pkgdir/opt/affection-vpn"
  cp -r "$srcdir"/data "$srcdir"/lib "$pkgdir/opt/affection-vpn/"
  install -Dm755 "$srcdir/affection_vpn" "$pkgdir/opt/affection-vpn/affection_vpn"
  install -Dm755 "$srcdir/xray" "$pkgdir/opt/affection-vpn/xray"
  install -Dm644 "$srcdir/geoip.dat" "$srcdir/geosite.dat" "$srcdir/LICENSE" \
    "$pkgdir/opt/affection-vpn/"

  install -d "$pkgdir/usr/bin"
  ln -s /opt/affection-vpn/affection_vpn "$pkgdir/usr/bin/affection-vpn"

  install -Dm644 "$srcdir/affection-vpn.desktop" \
    "$pkgdir/usr/share/applications/dev.affection.affection_vpn.desktop"
  install -Dm644 "$srcdir/affection-vpn.png" \
    "$pkgdir/usr/share/icons/hicolor/192x192/apps/affection-vpn.png"
}
